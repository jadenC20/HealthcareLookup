# Frontend server configuration. Copy to .env (ignored by Git).
# These Supabase values are PUBLIC and will be sent to the browser.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
# A legacy SUPABASE_ANON_KEY can be used instead of the publishable key.
# Never put secret or service_role keys in frontend configuration.
PORT=4182
CLEARCARE_API_URL=http://127.0.0.1:8000
