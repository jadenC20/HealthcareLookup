# Documentation template only: export values in your shell; no automatic dotenv loader.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1
OPENAI_SEARCH_MODEL=gpt-4.1
# Paths below are resolved relative to backend/goapp when using npm run dev.
CLEARCARE_DB=../clearcare.db
CLEARCARE_DATA_DIR=../data
# Optional extracted CMS Plan Attributes CSV or normalized plan CSV.
CLEARCARE_PLAN_CATALOG=
CLEARCARE_DEMO=0
CLEARCARE_SECURE_COOKIES=0
# Optional absolute Go executable for the Node launcher.
CLEARCARE_GO=go
