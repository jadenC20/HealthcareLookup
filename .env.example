# Copy to .env for the frontend server. Export backend secrets in the backend shell.
# These Supabase values are PUBLIC and will be sent to the browser.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
# A legacy SUPABASE_ANON_KEY can be used instead of the publishable key.
# Never put secret or service_role keys in frontend configuration.

# Frontend and backend listeners.
PORT=4182
CLEARCARE_API_URL=http://127.0.0.1:8000
CLEARCARE_ADDR=127.0.0.1:8000

# Backend-only AI configuration. Never expose this key to browser code.
CLEARCARE_AI_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemma-4-31b-it:free
# Optional legacy provider (set CLEARCARE_AI_PROVIDER=openai explicitly).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1
OPENAI_SEARCH_MODEL=gpt-4.1

# Local persistence adapter. Use memory for disposable local runs.
CLEARCARE_STORE=local-sqlite
# Paths are resolved relative to backend/goapp when using npm run backend.
CLEARCARE_DB=../clearcare.db
CLEARCARE_DATA_DIR=../data
CLEARCARE_PLAN_CATALOG=
CLEARCARE_DEMO=0
CLEARCARE_SECURE_COOKIES=0
# Alternative host/port configuration when CLEARCARE_ADDR is unset.
CLEARCARE_HOST=127.0.0.1
CLEARCARE_PORT=8000
CLEARCARE_ALLOWED_ORIGINS=http://127.0.0.1:4182,http://localhost:4182,http://127.0.0.1:8000,http://localhost:8000
# Completed product result/job retention, 1–3650 days.
CLEARCARE_RESULT_RETENTION_DAYS=90
CLEARCARE_GO=go
